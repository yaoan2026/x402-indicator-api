# 複製成 .env 再填值：cp .env.example .env

# ── 賣方（伺服器）──
# 你的收款錢包地址（公開地址，不是私鑰）
PAY_TO=0xYourReceivingWalletAddress
# 每次呼叫的價格（美元，用 USDC 結算）
PRICE='$0.001'
# eip155:84532 = Base Sepolia 測試網；上主網改成 eip155:8453（Base）
NETWORK=eip155:84532
# 測試網用公開的 facilitator，不需要帳號
FACILITATOR_URL=https://x402.org/facilitator
# 上主網時改成 true，並設定下面兩個 CDP 金鑰
USE_CDP_FACILITATOR=false
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# 設 false 可以在本機不收費測試
PAYMENTS_ENABLED=true

# ── 買方（client.py 測試用）──
# 只放「測試錢包」的私鑰，絕對不要放主力錢包
BUYER_PRIVATE_KEY=0xYourTestWalletPrivateKey
